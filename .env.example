BACKEND_API_URL=https://watsapp-web-backend.onrender.com
WORKER_PORT=4100
WORKER_API_KEY=change-me-to-a-long-random-secret
SESSIONS_DIR=./sessions
AUTO_START_FROM_CLAIMS=true
CLAIM_POLL_MS=5000
MAX_WAITING_STARTS=5
MONITORED_POLL_MS=15000
HISTORY_LIMIT=500
LOG_LEVEL=info
# Optional: comma-separated list of SOCKS5 or HTTP proxies to bypass AWS IP rate limits
PROXY_URLS=http://user:pass@proxy1.com:8080,socks5://user:pass@proxy2.com:1080

